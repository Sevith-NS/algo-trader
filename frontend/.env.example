# Next.js frontend — copy to frontend/.env.local and fill in.

# Base URL of the Flask backend, read by src/lib/api.ts. NEXT_PUBLIC_ prefix
# means this is inlined into the browser bundle, so it must be a public URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
